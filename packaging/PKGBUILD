# Maintainer: Ali
# AUR package medic-bin. On release: bump pkgver, then run `updpkgsums` and `makepkg --printsrcinfo > .SRCINFO`.
pkgname=medic-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Health checks for pipelines: gate deploys, smoke-test them, wait for dependencies"
arch=('x86_64' 'aarch64')
url="https://github.com/Rogsiel/medic"
license=('MIT')
provides=('medic')
conflicts=('medic')
source_x86_64=("medic-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/medic_linux_amd64.tar.gz")
source_aarch64=("medic-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/medic_linux_arm64.tar.gz")
sha256sums_x86_64=('UPDATE_ON_RELEASE')
sha256sums_aarch64=('UPDATE_ON_RELEASE')

package() {
  install -Dm755 medic "${pkgdir}/usr/bin/medic"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -dm755 "${pkgdir}/usr/share/bash-completion/completions" \
                 "${pkgdir}/usr/share/zsh/site-functions" \
                 "${pkgdir}/usr/share/fish/vendor_completions.d"
  ./medic completion bash > "${pkgdir}/usr/share/bash-completion/completions/medic"
  ./medic completion zsh  > "${pkgdir}/usr/share/zsh/site-functions/_medic"
  ./medic completion fish > "${pkgdir}/usr/share/fish/vendor_completions.d/medic.fish"
}
