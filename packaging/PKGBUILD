# Maintainer: Ali <alirahimi2002@proton.me>
pkgname=medic-cli
_pkg=medic
pkgver=0.1.1
pkgrel=1
pkgdesc='Health-check CLI for pipeline checkpoints, CI gates, and live terminal monitoring'
arch=('any')
url='https://github.com/Rogsiel/medic'
license=('MIT')
depends=('python' 'python-rich' 'python-psutil' 'python-requests'
         'python-cryptography' 'python-argcomplete')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$_pkg-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$_pkg-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkg-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Ship shell completions like any other package, so users need no setup.
  local site
  site=$(python -c 'import site; print(site.getsitepackages()[0])')
  export PYTHONPATH="$pkgdir$site"
  python -m medic --completion zsh  | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_medic"
  python -m medic --completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/medic"
  python -m medic --completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/medic.fish"
}
